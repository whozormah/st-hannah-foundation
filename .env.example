# Copy to .env.local and fill in real values.
# The app builds without these, but the features that use them fail at
# runtime until they are set.

# Public base URL, no trailing slash. Used for canonical URLs, the sitemap,
# OpenGraph tags and donation receipt links.
NEXT_PUBLIC_SITE_URL=https://sthannahfoundation.org

# Paystack secret key — donation initialise/verify and PDF receipts.
PAYSTACK_SECRET_KEY=

# Resend — donation receipts and foundation notification emails.
RESEND_API_KEY=

# Verified sender address for outgoing mail.
FROM_EMAIL=

# Internal inbox that receives donation and enquiry notifications.
DONATION_EMAIL=

# Optional. Dedicated inboxes for the volunteer, support-application and
# contact, newsletter and partnership forms.
# Both fall back to DONATION_EMAIL when unset, so submissions are never lost.
VOLUNTEER_EMAIL=
APPLICATIONS_EMAIL=
CONTACT_EMAIL=

# ── Platform (Phase 2) ────────────────────────────────────────────────────

# PostgreSQL. Locally: `npm run db:up` starts the container this matches.
DATABASE_URL=postgres://shf:shf_local_dev@127.0.0.1:55433/shf

# Signs admin sessions. Generate a long random value per environment and
# never reuse the production one anywhere else.
PAYLOAD_SECRET=

# Paystack webhook signing secret. Phase 5 verifies every webhook against it
# before the payload is trusted (PAY-02).
PAYSTACK_WEBHOOK_SECRET=

# Cloudflare R2. Media and documents live here, never on the droplet
# (MED-01). The storage adapter switches on only when these are set, so
# local development and the test suite run without cloud credentials.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=
R2_BUCKET_PRIVATE=
R2_BUCKET_BACKUPS=
# Only for testing against a local S3-compatible server; leave empty in
# production, where the address comes from R2_ACCOUNT_ID.
R2_ENDPOINT=

# Encrypts the nightly dump before it leaves the server (BAK-01). Losing this
# makes every backup unreadable: store it outside the droplet.
BACKUP_ENCRYPTION_KEY=
